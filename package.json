{
  "name": "divo",
  "version": "0.1.0",
  "private": true,
  "description": "DIVO - Discord voice companion that listens in voice channels and talks back",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "groq-sdk": "^1.6.0",
    "kokoro-js": "^1.2.1",
    "pino": "^10.4.0",
    "prism-media": "^1.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
