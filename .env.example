# Discord bot token (https://discord.com/developers/applications -> your app -> Bot)
DISCORD_TOKEN=
# Optional: register slash commands to one server so they appear instantly while developing
DISCORD_DEV_GUILD_ID=

# Groq (https://console.groq.com/keys): speech-to-text and the LLM
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
# low | medium | high | off. Defaults to low for reasoning models (gpt-oss, qwen), off otherwise.
GROQ_REASONING_EFFORT=
# Whisper language hint (e.g. en, id). Empty = auto-detect.
STT_LANGUAGE=

# Bot persona
BOT_NAME=Divo
# Comma-separated spellings speech-to-text might produce for the name
BOT_ALIASES=deevo,devo,dee vo
# Extra persona instructions appended to the system prompt
BOT_PERSONA=
FOLLOW_UP_WINDOW_MS=10000

# Kokoro local text-to-speech (voices: af_heart, af_bella, am_michael, bf_emma, ...)
KOKORO_VOICE=af_heart
# fp32 = best quality; q4 = fastest. q8 is slow on CPU.
KOKORO_DTYPE=fp32
KOKORO_SPEED=1

LOG_LEVEL=info
