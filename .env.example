# Discord bot token (https://discord.com/developers/applications -> your app -> Bot)
DISCORD_TOKEN=
# Optional: register slash commands to one server so they appear instantly while developing
DISCORD_DEV_GUILD_ID=

# Groq (https://console.groq.com/keys): speech-to-text and the LLM
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
# low | medium | high | off. Defaults to low for reasoning models (gpt-oss, qwen), off otherwise.
GROQ_REASONING_EFFORT=
# Whisper language hint (e.g. en, id). Empty = auto-detect.
STT_LANGUAGE=
# Segments Whisper rates above this no-speech probability (0-1) are ignored as noise.
# Lower = stricter. Run with LOG_LEVEL=debug to see what gets dropped.
STT_MAX_NO_SPEECH_PROB=0.6

# Bot persona
BOT_NAME=Divo
# Comma-separated spellings speech-to-text might produce for the name
BOT_ALIASES=deevo,devo,dee vo
# Default personality; servers can override it with /persona
BOT_PERSONA=
# Default voice (female | male); servers can override it with /voice
DEFAULT_VOICE=female
FOLLOW_UP_WINDOW_MS=10000

# Kokoro voices used for /voice female and /voice male
# Best rated: female af_heart (A), af_bella (A-); male am_michael, am_fenrir, am_puck (C+)
KOKORO_FEMALE_VOICE=af_heart
KOKORO_MALE_VOICE=am_michael
# fp32 = best quality; q4 = fastest. q8 is slow on CPU.
KOKORO_DTYPE=fp32
KOKORO_SPEED=1

# Where per-server settings (/voice, /persona) are saved
DATA_DIR=data

LOG_LEVEL=info
